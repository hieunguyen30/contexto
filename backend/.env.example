MONGODB_URI=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
PORT=4000
CORS_ORIGIN=http://localhost:3000
AUTH_MODE=dev            # dev = x-user-id header; firebase = verify Firebase ID tokens (required in production)
FIREBASE_PROJECT_ID=
RAW_TEXT_BUCKET=          # empty = keep raw_text inline in Mongo (local dev)
PUBSUB_TOPIC=             # empty = run ingestion in-process (local dev)
RETRIEVAL_BACKEND=memory  # memory | vertex
SMTP_URL=             # smtps://user:pass@host (reviews-due job)
MAIL_FROM=
APP_URL=
